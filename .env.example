ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Use a long random string (≥24 chars). Required in production / https BASE_URL.
SESSION_SECRET=change-me-to-a-long-random-string-please
ENV=development
BASE_URL=http://localhost:8080

# Local default: SQLite. On Render, set this to the Postgres Database URL.
# postgres://… from Render is auto-normalized to postgresql+psycopg://…
DATABASE_URL=sqlite:///./data/app.db

# GitHub OAuth — callback: http://localhost:8080/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
USER1_EMAIL=apasupuleti@copado.com
USER1_GITHUB_LOGIN=

# Google OAuth — callback: http://localhost:8080/auth/callback/google
# Enable/disable from Admin panel after credentials are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Salesforce Data Bridge (extension → ingestion API)
SALESFORCE_BRIDGE_URL=https://salesforce-data-bridge.onrender.com
SALESFORCE_BRIDGE_EMAIL=demo@example.com
SALESFORCE_BRIDGE_PASSWORD=demo-password
